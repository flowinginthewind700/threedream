{
  "name": "threedream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unreal-class game and physics-AI runtime on top of three.js: deterministic ECS + fixed-timestep simulation, pluggable physics, and in-browser reinforcement learning.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "train": "tsx scripts/train_headless.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "lucide": "^1.45.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
